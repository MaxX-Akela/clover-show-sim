"""clover-field list | use <файл или имя поля> | show"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'host'))
from cshow import common, containers, field  # noqa: E402


def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__)
        return
    if argv[0] == 'list':
        cur = field.active()
        for name, path in field.available().items():
            print('%s %-16s %d маркеров  %s' % ('*' if os.path.realpath(path) == cur else ' ', name,
                                                len(field.parse(path)), path))
    elif argv[0] == 'show':
        print(field.active())
    elif argv[0] == 'use' and len(argv) == 2:
        path = field.resolve(argv[1])
        if not field.parse(path):
            common.die('в файле нет ни одного маркера (формат: id размер x y [z yaw pitch roll])')
        field.activate(path)
        print('Поле: %s' % path)
        if containers.docker('info', check=False).returncode == 0 and containers.running_ids():
            print('Симуляция запущена: поле применится после перезапуска simulate.py.')
    else:
        common.die('использование: clover-field list | show | use <файл или имя поля>')


if __name__ == '__main__':
    main(sys.argv[1:])
